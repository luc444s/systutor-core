# Copy to .env and adjust values
SYSTUTOR_APP_NAME=SYSTUTOR API
SYSTUTOR_ENV=local
SYSTUTOR_DEBUG=true
SYSTUTOR_VERSION=0.1.0
SYSTUTOR_API_PREFIX=/api/v1
SYSTUTOR_LOG_LEVEL=INFO
SYSTUTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/systutor
SYSTUTOR_DB_POOL_SIZE=10
SYSTUTOR_DB_MAX_OVERFLOW=10
SYSTUTOR_DB_POOL_TIMEOUT=15
SYSTUTOR_DB_POOL_RECYCLE=1800
SYSTUTOR_DB_POOL_PRE_PING=true
SYSTUTOR_DB_POOL_USE_LIFO=true
SYSTUTOR_DB_ASYNC_POOL_SIZE=2
SYSTUTOR_DB_ASYNC_MAX_OVERFLOW=2
SYSTUTOR_DB_STATEMENT_TIMEOUT_MS=5000
SYSTUTOR_THREADPOOL_TOKENS=40
SYSTUTOR_AUTH_CACHE_ENABLED=true
SYSTUTOR_AUTH_CACHE_TTL_SECONDS=30
SYSTUTOR_REDIS_URL=redis://localhost:6379/0
SYSTUTOR_JWT_SECRET_KEY=change-me
SYSTUTOR_JWT_ACCESS_TOKEN_TTL_MINUTES=60
SYSTUTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYSTUTOR_PLUGINS_DIR=/absolute/path/to/plugins
SYSTUTOR_OUTBOX_DISPATCH_BATCH_SIZE=100
SYSTUTOR_OUTBOX_MAX_RETRIES=3
SYSTUTOR_SEED_ADMIN_EMAIL=admin@example.com
SYSTUTOR_SEED_ADMIN_PASSWORD=ChangeMe123!
SYSTUTOR_SEED_ADMIN_FULL_NAME=System Admin
